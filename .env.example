# Copy to .env for local development (never commit the real one).
DATABASE_URL=postgresql+asyncpg://stockguard:stockguard@localhost:5432/stockguard
ADMIN_API_KEY=change-me-to-a-long-random-string

# atomic | pessimistic | optimistic | naive (naive is intentionally broken, benchmarking only)
INVENTORY_STRATEGY=atomic

RESERVATION_TTL_SECONDS=600
SWEEPER_ENABLED=true
SWEEP_INTERVAL_SECONDS=5
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
LOG_LEVEL=INFO
